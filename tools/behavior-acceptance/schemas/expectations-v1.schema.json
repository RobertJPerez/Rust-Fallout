{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rust-fallout.behavior-expectations.v1",
  "title": "Rust Fallout independent behavior expectations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "scenario_id", "evidence_class", "oracle", "provenance_pins", "minimum_counts", "expected_timeline"],
  "properties": {
    "format": {"const": "rust-fallout.behavior-expectations"},
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "evidence_class": {"enum": ["synthetic_fixture", "engineering_capture"]},
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {"kind": {"enum": ["independent_fixture", "frozen_engine_capture"]}, "id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "provenance_pins": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "binary_sha256", "profile_id", "profile_fingerprint_sha256", "content_fingerprint_sha256"],
      "properties": {"source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "profile_id": {"type": "string"}, "profile_fingerprint_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "content_fingerprint_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "minimum_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "state", "event", "acknowledgment", "save"],
      "properties": {"input": {"type": "integer", "minimum": 1}, "state": {"type": "integer", "minimum": 1}, "event": {"type": "integer", "minimum": 0}, "acknowledgment": {"type": "integer", "minimum": 0}, "save": {"type": "integer", "minimum": 0}}
    },
    "expected_timeline": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "capture-v1.schema.json#/$defs/input"}, {"$ref": "capture-v1.schema.json#/$defs/state"}, {"$ref": "capture-v1.schema.json#/$defs/event"}, {"$ref": "capture-v1.schema.json#/$defs/acknowledgment"}, {"$ref": "capture-v1.schema.json#/$defs/save"}]}}
  },
  "allOf": [
    {"if": {"properties": {"evidence_class": {"const": "synthetic_fixture"}}, "required": ["evidence_class"]}, "then": {"properties": {"oracle": {"properties": {"kind": {"const": "independent_fixture"}}}}}},
    {"if": {"properties": {"evidence_class": {"const": "engineering_capture"}}, "required": ["evidence_class"]}, "then": {"properties": {"oracle": {"properties": {"kind": {"const": "frozen_engine_capture"}}}, "provenance_pins": {"properties": {"binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "profile_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}}
  ]
}
